# ==============================================================================
# ICICOS Agentic Hybrid RAG: Environment Configuration Template
# Copy this file to .env and insert your API credentials before running.
# ==============================================================================

# Primary LLM Configuration (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.0

# Cross-Backbone LLM Configuration (Groq Cloud - Optional for Qwen evaluation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Critic Verification & Bounded Self-Repair
MAX_REPAIR_ITERATIONS=2
CRITIC_CONFIDENCE_THRESHOLD=0.85

# Embedding Configuration
# Options: "sentence-transformer" (local, free) or "gemini" (cloud)
EMBEDDING_PROVIDER=sentence-transformer
SENTENCE_TRANSFORMER_MODEL=paraphrase-multilingual-MiniLM-L12-v2
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Vector Store Configuration
CHROMA_PERSIST_DIR=./data/vector_store
CHROMA_COLLECTION_NAME=sop_bpmn_knowledge

# Ingestion & Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAW_DATA_DIR=./data/raw

# Retrieval Configuration
TOP_K=4
SEARCH_TYPE=similarity
# Optional: mmr or similarity

# API Service Configuration (Optional)
DATABASE_URL=sqlite:///./data/icicos_rag.db
API_HOST=0.0.0.0
API_PORT=8000

